u mô tả)","photo":""}},{"id":"unesco_official_267","whcId":267,"officialWorldHeritage":true,"heritageType":"cultural","name":"Old City of Berne","title":"Old City of Berne","country":"Switzerland","lat":46.94806,"lng":7.45028,"latitude":46.94806,"longitude":7.45028,"continent":"Europe and North America","year":1983,"grade":"Tư liệu địa lý – lịch sử","kind":"","model3d":false,"sketchfabId":null,"shape":"Chưa có mô hình hình học được kiểm định","math":"Dữ liệu UNESCO chính thức; chưa có mô hình hình học được kiểm chứng.","history":"Founded in the 12th century on a hill site surrounded by the Aare River, Berne developed over the centuries in line with a an exceptionally coherent planning concept. The buildings in the Old City, dating from a variety of periods, include 15th-century arcades and 16th-century fountains. Most of the medieval town was restored in the 18th century but it has retained its original character.","explanation":"Di sản được UNESCO ghi danh. Chưa xác minh ảnh và mô hình 3D của riêng công trình.","unescoUrl":"https://whc.unesco.org/en/list/267/","photo":{"status":"pending_commons_image_review"},"media":{"source":"https://whc.unesco.org/en/list/267/","author":"UNESCO","license":"CC BY-SA 4.0 (dữ liệu mô tả)","photo":""}},{"id":"unesco_official_230","whcId":230,"officialWorldHeritage":true,"heritageType":"cultural","name":"Abbey Church of Saint-Savin sur Gartempe","title":"Abbey Church of Saint-Savin sur Gartempe","country":"France","lat":46.56472,"lng":0.86611,"latitude":46.56472,"longitude":0.86611,"continent":"Europe and North America","year":1983,"grade":"Tư liệu địa lý – lịch sử","kind":"","model3d":false,"sketchfabId":null,"shape":"Chưa có mô hình hình học được kiểm định","math":"Dữ liệu UNESCO chính thức; chưa có mô hình hình học được kiểm chứng.","history":"Known as the 'Romanesque Sistine Chapel', the Abbey-Church of Saint-Savin contains many beautiful 11th- and 12th-century murals which are still in a remarkable state of preservation.","expla